# Opcional: copiar a .env para cambiar los valores por defecto de docker-compose.yml
# (sin .env el proyecto funciona igual con estos mismos valores de demostracion).
DB_NAME=ordersystem
DB_USER=ordersystem
DB_PASSWORD=ordersystem
# Puerto de la API en el host
APP_PORT=8080
# Puerto de PostgreSQL en el host (5433 para no chocar con un PostgreSQL local)
DB_HOST_PORT=5433
